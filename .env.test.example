# Copy to the ignored .env.test file and replace placeholders with dedicated test-only values.
NODE_ENV=test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=ybgp_websites_test
TEST_DB_USER=ybgp_websites_test_user
TEST_DB_PASSWORD=
TEST_DB_ALLOW_REMOTE=false
# For remote MySQL only, set both values true after verifying the database and user are isolated from production.
TEST_DB_REMOTE_ISOLATED=false
