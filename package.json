{
  "name": "ybgp-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "server:start": "node build/server/index.js",
    "start": "node build/server/index.js",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "test:unit": "tsx --test server/admin/dates.test.ts",
    "test:seo": "npm run build && tsx --test server/seo/html.test.ts server/seo/output.test.ts",
    "test:auth": "tsx --test server/auth/auth.test.ts",
    "build": "vite build",
    "build:hostinger": "npm run build && npm run server:build",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "node -e \"const fs = require('node:fs'); for (const path of ['dist', 'build']) fs.rmSync(path, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mysql2": "^3.24.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
